// Prisma schema file for 1Fi assignment (PostgreSQL production-ready)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  brand       String
  description String
  badge       String?          // e.g. "NEW", "AI POWERED"
  basePrice   Int              // Starting display price in INR
  baseMrp     Int              // Starting display MRP in INR
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  variants    ProductVariant[]
  emiPlans    EmiPlan[]

  @@index([slug])
}

model ProductVariant {
  id          String         @id @default(cuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String         // e.g. "iPhone 17 Pro 256GB - Desert Titanium"
  color       String         // e.g. "Desert Titanium"
  colorHex    String         // e.g. "#C9A98C"
  storage     String         // e.g. "256GB"
  price       Int            // Price in INR for this specific variant
  mrp         Int            // MRP in INR for this specific variant
  sku         String         @unique
  stock       Int            @default(25)
  isDefault   Boolean        @default(false)

  images      VariantImage[]
  emiPlans    EmiPlan[]
  orders      Order[]

  @@index([productId])
  @@index([color, storage])
}

model VariantImage {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url         String
  alt         String
  isPrimary   Boolean        @default(false)
  order       Int            @default(0)

  @@index([variantId])
}

model EmiPlan {
  id                 String          @id @default(cuid())
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  monthlyAmount      Int             // Exact installment in INR (e.g. 11242)
  tenureMonths       Int             // 3, 6, 12, 24, 36, 48, 60
  interestRate       Float           // 0 or 10.5
  cashbackAmount     Int             @default(7500) // e.g. 7500
  mutualFundBacking  String          @default("EMI plans backed by mutual funds")
  isPopular          Boolean         @default(false)

  orders             Order[]

  @@index([productId])
  @@index([variantId])
}

model Order {
  id            String         @id @default(cuid())
  emiPlanId     String
  emiPlan       EmiPlan        @relation(fields: [emiPlanId], references: [id])
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  customerName  String
  customerPhone String
  customerEmail String
  panNumber     String?
  status        String         @default("CONFIRMED")
  createdAt     DateTime       @default(now())

  @@index([emiPlanId])
  @@index([variantId])
}
